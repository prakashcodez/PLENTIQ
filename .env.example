# Copy this file to .env and fill in local values. Never commit .env.
PLENTIQ_SECRET_KEY=replace-with-a-long-random-secret

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=plentiq_dev
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password

# Optional: configure these only when enabling browser push alerts.
PLENTIQ_VAPID_PUBLIC_KEY=
PLENTIQ_VAPID_PRIVATE_KEY_FILE=
PLENTIQ_VAPID_SUBJECT=
